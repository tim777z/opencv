# Copy to .env and adjust:  cp .env.example .env
#
# docker-compose.yml reads these; nothing here is a secret. There is no
# credential, token or key in this build: the build is fully offline after the
# container image and the optional opencv_extra checkout are in place.

# Parallel compile jobs. Keep this at or below the number of cores the container
# can actually use, otherwise the build thrashes instead of getting faster.
BUILD_JOBS=4

# Test fixtures for the accuracy tests. Clone the matching data once:
#   git clone -b 3.0 --depth 1 https://github.com/opencv/opencv_extra ../opencv_extra
# then point this at the clone (absolute path). Leave empty to configure without
# data-driven tests; those tests report FAIL_INVALID_TEST_DATA when their
# fixtures are missing.
OPENCV_TEST_DATA_PATH=
