{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 1,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci",
      "displayName": "CI Build (matches .github/workflows/ci.yml)",
      "description": "Minimal build configuration used by CI: tests enabled, no GUI/GPU/codec backends, no bindings.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "BUILD_TESTS": "ON",
        "BUILD_PERF_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_DOCS": "OFF",
        "BUILD_opencv_apps": "OFF",
        "BUILD_opencv_java": "OFF",
        "BUILD_opencv_python2": "OFF",
        "BUILD_opencv_python3": "OFF",
        "BUILD_opencv_viz": "OFF",
        "BUILD_opencv_videostab": "OFF",
        "BUILD_opencv_superres": "OFF",
        "BUILD_opencv_cudaarithm": "OFF",
        "BUILD_opencv_cudabgsegm": "OFF",
        "BUILD_opencv_cudacodec": "OFF",
        "BUILD_opencv_cudafeatures2d": "OFF",
        "BUILD_opencv_cudafilters": "OFF",
        "BUILD_opencv_cudaimgproc": "OFF",
        "BUILD_opencv_cudalegacy": "OFF",
        "BUILD_opencv_cudaobjdetect": "OFF",
        "BUILD_opencv_cudaoptflow": "OFF",
        "BUILD_opencv_cudastereo": "OFF",
        "BUILD_opencv_cudawarping": "OFF",
        "BUILD_opencv_cudev": "OFF",
        "BUILD_ZLIB": "ON",
        "BUILD_PNG": "ON",
        "BUILD_JPEG": "ON",
        "BUILD_TIFF": "ON",
        "BUILD_OPENEXR": "ON",
        "WITH_1394": "OFF",
        "WITH_CUDA": "OFF",
        "WITH_EIGEN": "OFF",
        "WITH_FFMPEG": "OFF",
        "WITH_GSTREAMER": "OFF",
        "WITH_GTK": "OFF",
        "WITH_IPP": "OFF",
        "WITH_JASPER": "OFF",
        "WITH_OPENCL": "OFF",
        "WITH_TBB": "OFF",
        "WITH_V4L": "OFF",
        "WITH_WEBP": "OFF"
      },
      "environment": {
        "CCACHE_DIR": "${sourceDir}/.ccache"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI AddressSanitizer Build",
      "description": "Debug build with AddressSanitizer for memory error detection. Inherits from 'ci' preset.",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build-ci-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer Build (full features)",
      "description": "Full-featured build for local development: all modules, bindings, docs, and backends enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "BUILD_TESTS": "ON",
        "BUILD_PERF_TESTS": "ON",
        "BUILD_EXAMPLES": "ON",
        "BUILD_DOCS": "ON",
        "BUILD_opencv_apps": "ON",
        "BUILD_opencv_java": "ON",
        "BUILD_opencv_python2": "OFF",
        "BUILD_opencv_python3": "ON",
        "BUILD_opencv_viz": "ON",
        "BUILD_opencv_videostab": "ON",
        "BUILD_opencv_superres": "ON",
        "BUILD_ZLIB": "ON",
        "BUILD_PNG": "ON",
        "BUILD_JPEG": "ON",
        "BUILD_TIFF": "ON",
        "BUILD_OPENEXR": "ON",
        "WITH_1394": "OFF",
        "WITH_CUDA": "OFF",
        "WITH_EIGEN": "ON",
        "WITH_FFMPEG": "ON",
        "WITH_GSTREAMER": "ON",
        "WITH_GTK": "ON",
        "WITH_IPP": "OFF",
        "WITH_JASPER": "OFF",
        "WITH_OPENCL": "ON",
        "WITH_TBB": "ON",
        "WITH_V4L": "ON",
        "WITH_WEBP": "ON"
      },
      "environment": {
        "CCACHE_DIR": "${sourceDir}/.ccache"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Developer Debug Build",
      "description": "Debug build with symbols and no optimization for interactive debugging.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build-dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build (matches .github/workflows/release.yml)",
      "description": "Production release build: all modules enabled, optimized, with docs.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "BUILD_TESTS": "OFF",
        "BUILD_PERF_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_DOCS": "ON",
        "BUILD_opencv_apps": "ON",
        "BUILD_opencv_java": "ON",
        "BUILD_opencv_python2": "OFF",
        "BUILD_opencv_python3": "ON",
        "BUILD_opencv_viz": "ON",
        "BUILD_opencv_videostab": "ON",
        "BUILD_opencv_superres": "ON",
        "BUILD_ZLIB": "ON",
        "BUILD_PNG": "ON",
        "BUILD_JPEG": "ON",
        "BUILD_TIFF": "ON",
        "BUILD_OPENEXR": "ON",
        "WITH_1394": "OFF",
        "WITH_CUDA": "OFF",
        "WITH_EIGEN": "OFF",
        "WITH_FFMPEG": "ON",
        "WITH_GSTREAMER": "ON",
        "WITH_GTK": "ON",
        "WITH_IPP": "OFF",
        "WITH_JASPER": "OFF",
        "WITH_OPENCL": "ON",
        "WITH_TBB": "ON",
        "WITH_V4L": "ON",
        "WITH_WEBP": "ON"
      },
      "environment": {
        "CCACHE_DIR": "${sourceDir}/.ccache"
      }
    },
    {
      "name": "minimal",
      "displayName": "Minimal Build (core only)",
      "description": "Smallest possible build: only core module, no tests, no third-party codecs.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "BUILD_TESTS": "OFF",
        "BUILD_PERF_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "BUILD_DOCS": "OFF",
        "BUILD_opencv_apps": "OFF",
        "BUILD_opencv_java": "OFF",
        "BUILD_opencv_python2": "OFF",
        "BUILD_opencv_python3": "OFF",
        "BUILD_opencv_viz": "OFF",
        "BUILD_opencv_videostab": "OFF",
        "BUILD_opencv_superres": "OFF",
        "BUILD_opencv_cudaarithm": "OFF",
        "BUILD_opencv_cudabgsegm": "OFF",
        "BUILD_opencv_cudacodec": "OFF",
        "BUILD_opencv_cudafeatures2d": "OFF",
        "BUILD_opencv_cudafilters": "OFF",
        "BUILD_opencv_cudaimgproc": "OFF",
        "BUILD_opencv_cudalegacy": "OFF",
        "BUILD_opencv_cudaobjdetect": "OFF",
        "BUILD_opencv_cudaoptflow": "OFF",
        "BUILD_opencv_cudastereo": "OFF",
        "BUILD_opencv_cudawarping": "OFF",
        "BUILD_opencv_cudev": "OFF",
        "BUILD_ZLIB": "OFF",
        "BUILD_PNG": "OFF",
        "BUILD_JPEG": "OFF",
        "BUILD_TIFF": "OFF",
        "BUILD_OPENEXR": "OFF",
        "WITH_1394": "OFF",
        "WITH_CUDA": "OFF",
        "WITH_EIGEN": "OFF",
        "WITH_FFMPEG": "OFF",
        "WITH_GSTREAMER": "OFF",
        "WITH_GTK": "OFF",
        "WITH_IPP": "OFF",
        "WITH_JASPER": "OFF",
        "WITH_OPENCL": "OFF",
        "WITH_TBB": "OFF",
        "WITH_V4L": "OFF",
        "WITH_WEBP": "OFF"
      },
      "environment": {
        "CCACHE_DIR": "${sourceDir}/.ccache"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "configuration": "Debug",
      "jobs": 0,
      "targets": ["opencv_test_core", "opencv_test_imgproc", "opencv_test_imgcodecs"]
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "configuration": "Release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"timeout": 900, "jobs": 0}
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "configuration": "Debug",
      "output": {"outputOnFailure": true},
      "execution": {"timeout": 300, "jobs": 0},
      "filter": {"include": {"name": "opencv_test_(core|imgproc|imgcodecs)"}}
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"timeout": 1800, "jobs": 0}
    }
  ]
}